char* addStrings(char* num1, char* num2) {
    int i = strlen(num1) - 1;
    int j = strlen(num2) - 1;
    int carry = 0;

    int n = strlen(num1);
    int m = strlen(num2);
    int size = (n > m ? n : m) + 2;

    char *ans = malloc(size);
    int k = size - 1;

    ans[k] = '\0';
    k--;

    while (i >= 0 || j >= 0 || carry) {
        int sum = carry;

        if (i >= 0)
            sum += num1[i--] - '0';

        if (j >= 0)
            sum += num2[j--] - '0';

        ans[k--] = (sum % 10) + '0';
        carry = sum / 10;
    }

    // Shift result to beginning
    int start = k + 1;
    int p = 0;

    while (ans[start] != '\0') {
        ans[p++] = ans[start++];
    }

    ans[p] = '\0';

    return ans;
}
