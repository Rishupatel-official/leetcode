int maxFreqSum(char* s) {
    int hash[26]={0};
    int maxvow=0;
    int maxcons=0;
    int i=0;
    while(s[i]!='\0'){
        hash[s[i]-'a']++;
        i++;
    }
    for(int i=0;i<26;i++){
        if(i==0 || i==4 || i==8 || i==14 || i==20){
            if(hash[i]>maxvow){
                maxvow=hash[i];
            }
        }else{
            if(hash[i]>maxcons){
                maxcons=hash[i];
            }
        }
    }return maxvow+maxcons;

}
