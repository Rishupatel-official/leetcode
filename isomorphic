bool isIsomorphic(char* s, char* t) {
    int mapST[128] = {0};
    int mapTS[128] = {0};

    for (int i = 0; s[i] != '\0'; i++) {

        if (mapST[s[i]] == 0 && mapTS[t[i]] == 0) {
            mapST[s[i]] = t[i];
            mapTS[t[i]] = s[i];
        }
        else {
            if (mapST[s[i]] != t[i] || mapTS[t[i]] != s[i]) {
                return false;
            }
        }
    }

    return true;
}
